# AWS Region and credentials (uses your AWS CLI profile)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1

# DynamoDB (must exist — create via CDK first, or use local DynamoDB)
CHAT_TABLE=noor-ai-chat-history

# Session config
SESSION_TTL_HOURS=72
MAX_HISTORY_MESSAGES=20
