# CDK deployment target. Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is the committed template.

# AWS account ID to deploy into (12 digits).
CDK_DEFAULT_ACCOUNT=123456789012

# AWS region to deploy into. Defaults to us-east-1 if unset.
CDK_DEFAULT_REGION=us-east-1

# Optional: email address for error-rate alarm notifications.
# When set, the observability stack creates an SNS topic with an email
# subscription and wires it to the alarm. Leave unset to skip notifications.
# ALARM_EMAIL=you@example.com
